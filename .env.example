# DEWI JATENG - Environment Variables Example (Pure PostgreSQL 16 & Drizzle ORM)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL 16 Database Configuration (OrbStack PostGIS Port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dewijateng
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dewijateng
POSTGRES_PORT=5433

# Adminer Web Database GUI (OrbStack)
ADMINER_PORT=8088

# Storage Directory (Local Object/Media Storage for PDFs & Images)
UPLOAD_DIR=./public/uploads

# AI / LLM Gateway Configuration (Google Gemini & OpenAI Compatible)
GEMINI_API_KEY=your-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.5-flash

# Salt hash satu arah nomor pelapor anonim (WAJIB diisi di production)
REPORTER_HASH_SALT=change-me-to-a-long-random-secret

# Salt hash satu arah nomor pelapor anonim (WAJIB diisi di production)
REPORTER_HASH_SALT=change-me-to-a-long-random-secret

# Autentikasi sesi (HMAC). WAJIB diganti di production.
AUTH_SECRET=change-me-to-a-long-random-secret
AUTH_PENGELOLA=pengelola2026
AUTH_PEMBINA=pembina2026

# Mode demo email: tautan verifikasi/reset ditampilkan di layar + log server.
# Set false setelah SMTP dikonfigurasi agar tautan tidak bocor ke klien.
DEMO_MAIL=true

