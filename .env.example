# DEWI JATENG - Environment Variables Example (Pure PostgreSQL 16 & Drizzle ORM)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL 16 Database Configuration (OrbStack PostGIS Port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dewijateng
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dewijateng
POSTGRES_PORT=5433

# Adminer Web Database GUI (OrbStack)
ADMINER_PORT=8088

# Storage Directory (Local Object/Media Storage for PDFs & Images)
UPLOAD_DIR=./public/uploads

# AI / LLM Gateway Configuration (OpenAI Compatible)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=ag/gemini-3.8-flash

