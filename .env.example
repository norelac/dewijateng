# DEWI JATENG - Environment Variables Example (Pure PostgreSQL 16 + PostGIS & Drizzle ORM)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL 16 Database Configuration (OrbStack PostGIS Port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dewijateng
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dewijateng
POSTGRES_PORT=5433

# Adminer Web Database GUI (OrbStack)
ADMINER_PORT=8088

# Storage Directory (Local Media Storage for PDFs & Images)
UPLOAD_DIR=./public/uploads

# Autentikasi sesi (HMAC). WAJIB diganti di production.
SESSION_SECRET=change-me-to-a-long-random-secret

# Salt hash satu arah nomor pelapor anonim. WAJIB diisi di production,
# kalau kosong pelaporan anonim akan melempar error.
REPORTER_HASH_SALT=change-me-to-a-long-random-secret

# SMTP pengiriman email (verifikasi, reset sandi, undangan akun desa).
# Kalau kosong, aplikasi otomatis jatuh ke mode demo: tautan tampil di layar.
# Port 465 = TLS langsung (set SMTP_SECURE=true), port 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DEWI JATENG <no-reply@example.com>"

# AI / LLM Gateway Configuration (Google Gemini & OpenAI Compatible).
# Kalau dibiarkan kosong, pencocokan harga SSH hanya memakai kata kunci.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
